# Local environment example for the url shortener
# Copy to .env and set the values for your environment.

ENV=development
DATABASE_URL=sqlite:///urls.db
POSTGRES_URL=postgresql+psycopg://postgres:postgres@localhost:5432/url_shortener
REDIS_URL=redis://localhost:6379/0
ANALYTICS_API_KEY=change-me-to-a-long-random-secret
TRUSTED_PROXY_CIDRS=["127.0.0.1/32","::1/128"]
ENABLE_RATE_LIMITS=false
RATE_LIMIT_CREATE_PER_MINUTE=60
RATE_LIMIT_REDIRECT_PER_MINUTE=600
RATE_LIMIT_ANALYTICS_PER_MINUTE=60
LOG_LEVEL=INFO
METRICS_HOST=127.0.0.1
METRICS_PORT=9100
