# Local environment example for the url shortener
# Copy to .env and set the values for your environment.

ENV=development
USE_POSTGRES=true
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/url_shortener
POSTGRES_URL=postgresql+psycopg://postgres:postgres@localhost:5432/url_shortener
REDIS_URL=redis://localhost:6379/0
ANALYTICS_API_KEY=change-me-in-production
ENABLE_RATE_LIMITS=true
TRUSTED_PROXY_CIDRS=["127.0.0.1/32","::1/128"]
RATE_LIMITS=true
RATE_LIMIT_CREATE_PER_MINUTE=60
RATE_LIMIT_REDIRECT_PER_MINUTE=600
RATE_LIMIT_ANALYTICS_PER_MINUTE=60
LOG_LEVEL=INFO
METRICS_HOST=127.0.0.1
METRICS_PORT=9100
